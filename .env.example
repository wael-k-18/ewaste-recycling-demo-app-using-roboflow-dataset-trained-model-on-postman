# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=ewaste_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=5242880

# AI Service (optional)
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.example.com/v1
